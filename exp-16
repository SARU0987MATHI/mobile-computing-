import math

f = float(input("Enter frequency (MHz): "))
d = float(input("Enter distance (km): "))
pt = float(input("Enter transmitted power (dBm): "))

fspl = 32.44 + 20 * math.log10(f) + 20 * math.log10(d)

pr = pt - fspl

print("Free Space Path Loss:", round(fspl, 2), "dB")
print("Received Power:", round(pr, 2), "dBm")
