import math

i = int(input("Enter value of i: "))
j = int(input("Enter value of j: "))
n = i*i + i*j + j*j

cells = int(input("Enter total number of cells: "))
channels = int(input("Enter total available channels: "))

capacity = (cells / n) * channels

q = math.sqrt(3 * n)
si = 10 * math.log10((q ** 4) / 6)

print("Cluster Size:", n)
print("System Capacity:", int(capacity))
print("Reuse Ratio:", round(q, 2))
print("S/I Ratio:", round(si, 2), "dB")
